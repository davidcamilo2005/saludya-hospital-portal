# Copiar este archivo a .env y ajustar los valores para desarrollo local.
# En Docker Compose estas variables se inyectan desde el .env de la raíz
# del proyecto; este archivo es para correr el backend SIN Docker
# (uvicorn app.main:app --reload) contra un PostgreSQL propio.

# Cadena de conexión SQLAlchemy a PostgreSQL.
DATABASE_URL=postgresql+psycopg2://saludya:saludya@localhost:5432/saludya

# Clave usada para firmar los JWT. OBLIGATORIO cambiarla en producción
# por un valor aleatorio largo (por ejemplo: openssl rand -hex 32).
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Orígenes permitidos por CORS (lista separada por comas, sin espacios).
CORS_ORIGINS=["http://localhost:5173"]

# Reglas de negocio de citas (Fase 1).
APPOINTMENT_START_HOUR=7
APPOINTMENT_END_HOUR=17
