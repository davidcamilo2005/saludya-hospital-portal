# =========================================================
# SaludYa - Variables de entorno para Docker Compose
# =========================================================
# Copiar este archivo a .env (en la raíz del proyecto) antes de ejecutar
# `docker compose up --build`. NUNCA subir el .env real a GitHub: ya está
# excluido en .gitignore. Los archivos backend/.env.example y
# frontend/.env.example documentan las mismas variables para correr cada
# servicio SIN Docker (ver docs/MANUAL_DESARROLLADOR.md).

# ---------------------------------------------------------
# PostgreSQL (contenedor "db")
# ---------------------------------------------------------
POSTGRES_USER=saludya
POSTGRES_PASSWORD=saludya
POSTGRES_DB=saludya
POSTGRES_PORT=5432

# ---------------------------------------------------------
# Backend (contenedor "backend")
# ---------------------------------------------------------
# Se construye a partir de las variables de PostgreSQL de arriba; no hace
# falta repetirlas si se usa docker-compose.yml tal como está.
JWT_SECRET_KEY=change-this-to-a-long-random-value-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
APPOINTMENT_START_HOUR=7
APPOINTMENT_END_HOUR=17
BACKEND_PORT=8000

# ---------------------------------------------------------
# Frontend (contenedor "frontend")
# ---------------------------------------------------------
# URL que el navegador usa para llamar a la API. Con el proxy de Nginx
# (frontend/nginx.conf) basta con /api/v1; solo cambia si se expone el
# backend directamente en otro host/puerto.
VITE_API_URL=/api/v1
FRONTEND_PORT=8080
