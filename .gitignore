# =========================================================
# SaludYa - .gitignore raíz
# =========================================================

# --- Entornos y variables sensibles ---
.env
.env.*.local
*.env
!*.env.example

# --- Backend (Python) ---
backend/.venv/
backend/venv/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
backend/alembic/versions/*.py
!backend/alembic/versions/.gitkeep

# --- Frontend (Node) ---
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Docker / bases de datos locales ---
*.db
*.sqlite3
postgres-data/

# --- Editores / SO ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
